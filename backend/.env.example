BBOX=-97.65,32.45,-96.25,33.3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPSTREAM_USER_AGENT=TexasResponse-Hackathon/0.1
NWPS_GAUGES=dalt2
# TomTom traffic: key stays private; DFW needs two requests per polling cycle.
TOMTOM_API_KEY=
TOMTOM_POLL_SECONDS=900
# Optional Spacetime bridge; never put its secret in a VITE_ variable.
# SPACETIME_INGEST_URL=https://maincloud.spacetimedb.com/v1/database/YOUR_DATABASE/route/ingest
# SPACETIME_INGEST_SECRET=generate-a-private-random-secret
# Optional comma-separated subset; omit to enable all 12 adapters.
# ENABLED_SOURCES=nws_alerts,nws_weather,nwps,usgs_water,dallas_police,iem,nifc,earthquakes,fema_shelters,dallas_gis,openfreemap,overpass,dallas_311,eonet
# Optional Nemotron summaries. Leave NVIDIA_API_KEY empty to disable; everything else keeps working.
# NVIDIA_BASE_URL works with any OpenAI-compatible endpoint (hosted NVIDIA API, or a self-hosted NIM on Brev).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
