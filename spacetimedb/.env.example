# Backend API keys for the Spacetime module (read in procedures as ctx.env.NAME).
# Copy to spacetimedb/.env, fill in what you have, and supply the values when
# publishing. spacetimedb/.env is gitignored. Never prefix these with VITE_.
# Every key is optional; leave blank until you have it.

NVIDIA_API_KEY=
DRIVETEXAS_API_KEY=
AIRNOW_API_KEY=
FIRMS_MAP_KEY=
DART_API_KEY=
USGS_API_KEY=
SOCRATA_APP_TOKEN=

# Not secret. NWS asks for app and contact info, e.g. (texas-response, you@example.com)
NWS_USER_AGENT=
